NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/banker_tips?retryWrites=true&w=majority
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:3000

# First admin account is created/updated from these values on startup.
# Use a unique strong password. Remove ADMIN_PASSWORD after bootstrap if desired,
# then manage the account using your secure operational process.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisToALongUniquePassword123!
