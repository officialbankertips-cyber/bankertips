NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/banker_tips?retryWrites=true&w=majority
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:3000

# First admin account is created/updated from these values on startup.
# Use a unique strong password. Remove ADMIN_PASSWORD after bootstrap if desired,
# then manage the account using your secure operational process.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisToALongUniquePassword123!

# KENYA — its own legacy M-Pesa STK Push credentials and collection account.
# The OPTIMAPAY_* legacy names remain supported as fallbacks for existing deployments.
KE_OPTIMAPAY_API_KEY=your_kenya_api_key
KE_OPTIMAPAY_API_SECRET=your_kenya_api_secret
KE_OPTIMAPAY_PAYMENT_ACCOUNT_ID=your_kenya_payment_account_id

# TANZANIA + UGANDA — one shared Global API credential pair and one shared merchant account.
TZUG_OPTIMAPAY_API_KEY=your_shared_tanzania_uganda_api_key
TZUG_OPTIMAPAY_API_SECRET=your_shared_tanzania_uganda_api_secret
TZUG_OPTIMAPAY_ACCOUNT_ID=your_shared_tanzania_uganda_account_id
# API-Football (API-Sports) - keep this key on the server only
FOOTBALL_API_KEY=paste_your_api_football_key_here
FOOTBALL_API_BASE_URL=https://v3.football.api-sports.io
FOOTBALL_API_TIMEZONE=Africa/Nairobi

# Polling interval in milliseconds; default 600000 (10 minutes), minimum 120000
FOOTBALL_SYNC_INTERVAL_MS=600000

# Never reuse Kenya credentials for the Tanzania/Uganda Global API. Keep all
# three credential groups server-side and configure them in your hosting secrets.
# The Global API documentation authenticates via X-API-KEY and X-API-SECRET;
# it does not define an account_id field in the collection JSON body. The shared
# TZUG account ID is retained here as the merchant-account reference supplied by OptimaPay.
