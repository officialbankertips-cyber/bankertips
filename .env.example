NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/banker_tips?retryWrites=true&w=majority
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:3000

# First admin account bootstrap
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_UNIQUE_PASSWORD

# OptimaPay Collecto API (shared base; endpoints are /collecto/initiate and /collecto/status/{identifier})
OPTIMA_BASE_URL=https://global.optimapaybridge.co.ke/api/v2

# Kenya credentials — keep values only in Render Environment
KE_OPTIMAPAY_API_KEY=your_kenya_api_key
KE_OPTIMAPAY_API_SECRET=your_kenya_api_secret
KE_OPTIMAPAY_ACCOUNT_ID=your_kenya_account_id

# Tanzania credentials — keep values only in Render Environment
TZ_OPTIMAPAY_API_KEY=your_tanzania_api_key
TZ_OPTIMAPAY_API_SECRET=your_tanzania_api_secret
TZ_OPTIMAPAY_ACCOUNT_ID=your_tanzania_account_id

# Confirm your intended Tanzania subscription prices before going live
TZ_PRICE_DAILY=5000
TZ_PRICE_WEEKLY=30000
TZ_PRICE_MONTHLY=70000
